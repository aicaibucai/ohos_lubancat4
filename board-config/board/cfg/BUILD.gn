import("//build/ohos.gni")

ohos_prebuilt_etc("init.lubancat4.cfg") {
  source = "init.lubancat4.cfg"
  part_name = "device_rk3588"
  install_images = [ chipset_base_dir ]
  install_enable = true
}

ohos_prebuilt_etc("init.lubancat4.usb.cfg") {
  source = "init.lubancat4.usb.cfg"
  part_name = "device_rk3588"
  install_images = [ chipset_base_dir ]
  install_enable = true
}

ohos_prebuilt_etc("fstab.lubancat4") {
  source = "fstab.lubancat4"
  part_name = "device_rk3588"
  install_images = [ vendor_base_dir ]
  install_enable = true
}

ohos_prebuilt_etc("fstab.required") {
  # 第一阶段挂载必需（无 ramdisk 时 init 从 /system/etc/fstab.required 读取，
  # 否则 /vendor、/data 都挂不上，appspawn 反复退出触发 reboot panic）。
  source = "fstab.required"
  part_name = "device_rk3588"
  install_images = [ system_base_dir ]
  install_enable = true
}

ohos_prebuilt_etc("lubancat4-init.cfg") {
  source = "lubancat4-init.cfg"
  relative_install_dir = "init"
  part_name = "device_rk3588"
  install_images = [ system_base_dir ]
  install_enable = true
}

ohos_prebuilt_etc("lubancat-init.sh") {
  source = "lubancat-init.sh"
  relative_install_dir = "bin"
  part_name = "device_rk3588"
  install_images = [ system_base_dir ]
  install_enable = true
  module_install_dir = "system/bin"
}

group("init_configs") {
  deps = [
    ":fstab.lubancat4",
    ":init.lubancat4.cfg",
    ":init.lubancat4.usb.cfg",
    ":lubancat4-init.cfg",
    ":lubancat-init.sh",
  ]
}

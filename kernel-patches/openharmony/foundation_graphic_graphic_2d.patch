-    static void* dlglv3Handle = dlopen("/system/lib64/libGLESv3.so", RTLD_NOW | RTLD_LOCAL);
+    /* [LOCAL FIX] 本产品把 GLES wrapper 库安装在 /system/lib64/platformsdk/ 下，
+     * 而原代码硬编码的 /system/lib64/libGLESv3.so 并不存在（本文件 32 位分支
+     * 用的就是带 platformsdk 的路径）。dlopen 失败会使 eglGetProcAddress 拿不到
+     * 符号，导致 SystemUI 画不出内容 —— 表现为整屏黑（DRM 侧一切正常）。
+     * 这里按顺序回退查找，兼容两种布局。 */
+    dlglv3Handle = dlopen("/system/lib64/libGLESv3.so", RTLD_NOW | RTLD_LOCAL);
+    if (dlglv3Handle == nullptr) {
+        dlglv3Handle = dlopen("/system/lib64/platformsdk/libGLESv3.so", RTLD_NOW | RTLD_LOCAL);
+    }
+    if (dlglv3Handle == nullptr) {
+        dlglv3Handle = dlopen("libGLESv3.so", RTLD_NOW | RTLD_LOCAL);
+    }
 #else
-    static void* dlglv3Handle = dlopen("/system/lib/platformsdk/libGLESv3.so", RTLD_NOW | RTLD_LOCAL);
+    dlglv3Handle = dlopen("/system/lib/platformsdk/libGLESv3.so", RTLD_NOW | RTLD_LOCAL);
 #endif
+    }
     if (dlglv3Handle == nullptr) {
         WLOGE("Failed to load GLES library using dl open");
         return nullptr;

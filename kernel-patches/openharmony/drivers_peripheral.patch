+extern "C" int32_t RegRefreshCallback(RefreshCallback cb, void *data)
+{
+    if (cb == nullptr) {
+        DISPLAY_LOGE("RegRefreshCallback: refresh callback is nullptr");
+        return HDF_FAILURE;
+    }
+    gRefreshCb = cb;
+    gRefreshData = data;
+    std::shared_ptr<VsyncCallBack> vsyncCb =
+        std::make_shared<VsyncCallBack>(RefreshVBlankTrampoline, nullptr, 0);
+    DrmVsyncWorker::GetInstance().ReqesterVBlankCb(vsyncCb);
+    DrmVsyncWorker::GetInstance().EnableVsync(true);
+    return HDF_SUCCESS;
+}

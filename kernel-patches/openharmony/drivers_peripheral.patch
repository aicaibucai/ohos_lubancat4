diff --git a/display/composer/vdi_base/src/hdi_drm_composition.cpp b/display/composer/vdi_base/src/hdi_drm_composition.cpp
index 0e6e88bea..d437395b1 100644
--- a/display/composer/vdi_base/src/hdi_drm_composition.cpp
+++ b/display/composer/vdi_base/src/hdi_drm_composition.cpp
@@ -15,6 +15,7 @@
 
 #include "hdi_drm_composition.h"
 #include <cerrno>
+#include <unistd.h>
 #include "hdi_drm_layer.h"
 
 namespace OHOS {
@@ -287,21 +288,37 @@ int32_t HdiDrmComposition::Apply(bool modeSet)
     /* Remove useless planes from the drm */
     RemoveUnusePlane(atomicReqPtr.Get());
 
-    ret = drmModeAtomicAddProperty(pset, mConnector->GetId(), mConnector->GetPropCrtcId(), mCrtc->GetId());
-    DISPLAY_LOGD("set the connector id: %{public}d, propId %{public}d, crtcId %{public}d", mConnector->GetId(),
-        mConnector->GetPropCrtcId(), mCrtc->GetId());
-    DISPLAY_CHK_RETURN((ret < 0), DISPLAY_FAILURE,
-        DISPLAY_LOGE("can not add the crtc id prop %{public}d", errno));
-
-    // set to active
-    DISPLAY_LOGD("set crtc to active");
-    ret = drmModeAtomicAddProperty(pset, mCrtc->GetId(), mCrtc->GetActivePropId(), 1);
-    DISPLAY_CHK_RETURN((ret < 0), DISPLAY_FAILURE,
-        DISPLAY_LOGE("can not add the active prop errno %{public}d", errno));
+    // [LubanCat4 bring-up fix] 不再每帧重设 connector CRTC_ID 与 CRTC ACTIVE：
+    // ① 这两项已由 Apply() 开头的 UpdateMode() 在 mCrtc->NeedModeSet() 时设置，
+    //    并用 DRM_MODE_ATOMIC_ALLOW_MODESET 提交；DRM 原子状态是持久的，无需重复设置。
+    // ② 每帧写 CRTC 的 ACTIVE 会令该 CRTC 的 active_changed=true，于是
+    //    drm_atomic_crtc_needs_modeset() 恒为真 → 内核每帧重跑完整 modeset 检查 →
+    //    dw_hdmi_rockchip_encoder_atomic_check() → hdmi_select_link_config()
+    //    → 实测：移动鼠标时内核 "use tmds mode" 达 ~41 次/秒（静止时为 0），
+    //      且 drmModeAtomicCommit 频繁返回 EBUSY(-16)（modeset 类提交互相挤占）→ 丢帧。
+    // ③ 去掉后本帧只剩平面属性 + out-fence，等价于纯 page-flip。
+    // 若日后出现"设置模式后不亮屏"，应先查 UpdateMode()/SetActiveMode() 路径，
+    // 不要把这两句加回来。
 
     uint32_t flags = DRM_MODE_ATOMIC_NONBLOCK;
 
-    ret = drmModeAtomicCommit(drmFd, atomicReqPtr.Get(), flags, nullptr);
+    // [LubanCat4 bring-up fix 2] EBUSY 不是致命错误：
+    // NONBLOCK 提交在上一次 flip 尚未完成时会返回 -EBUSY，原实现直接 DISPLAY_CHK_RETURN
+    // 丢弃该帧（实测移动鼠标时 ~36 次/秒）。这里改为有限次重试，最后一次退化为阻塞提交
+    // （去掉 NONBLOCK，内核会等上一次提交完成，不会再返回 EBUSY），只有真正的错误才上报失败。
+    // 配合 fix 1（去掉每帧 modeset 属性）使用：fix 1 把 EBUSY 从 ~36/秒 降到 ~2/秒，
+    // fix 2 消化这部分残留，避免丢帧造成的抖动。
+    constexpr int32_t MAX_COMMIT_RETRY = 3;
+    for (int32_t attempt = 0; attempt <= MAX_COMMIT_RETRY; attempt++) {
+        if (attempt == MAX_COMMIT_RETRY) {
+            flags &= ~static_cast<uint32_t>(DRM_MODE_ATOMIC_NONBLOCK);
+        }
+        ret = drmModeAtomicCommit(drmFd, atomicReqPtr.Get(), flags, nullptr);
+        if (ret == 0 || errno != EBUSY) {
+            break;
+        }
+        usleep(2000); // 2ms：给上一次 flip 一点退休时间
+    }
     DISPLAY_CHK_RETURN((ret != 0), DISPLAY_FAILURE,
         DISPLAY_LOGE("drmModeAtomicCommit failed %{public}d errno %{public}d", ret, errno));

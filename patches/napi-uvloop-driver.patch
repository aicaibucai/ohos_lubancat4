+// [LubanCat4 补丁 2026-10-01] 在 JS 线程上跑一次 uv loop，让 uv_queue_work 的完成回调
+// （AsyncAfterWorkCallback）被调度。宿主已经挂好 uv loop 驱动时，多跑一次是无害的。
+void NativeAsyncWork::PostUvLoopPump()
+{
+    if (uvLoopPumpHandler_ == nullptr || engine_ == nullptr) {
+        return;
+    }
+    NativeEngine* engine = engine_;
+    uint64_t engineId = engineId_;
+    uvLoopPumpHandler_->PostTask([engine, engineId]() {
+        if (engine->GetId() != engineId) {
+            return;
+        }
+        engine->Loop(LOOP_NOWAIT, false);
+    }, "LubanCat4UvLoopPump");
+}

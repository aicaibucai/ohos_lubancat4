+// [LubanCat4 补丁 2026-10-01] 每个 JS 线程（EventRunner）只创建一个 loop 泵 EventHandler，
+// 并在进程生命周期内一直持有它：EventHandler 构造时会把自身注册进 EventQueue 的观察者列表，
+// 若随即析构会在队列里留下悬垂指针（主线程下一轮 GetEvent 时跳野地址崩溃）。
+namespace {
+std::mutex g_uvLoopPumpMutex;
+std::map<OHOS::AppExecFwk::EventRunner*, std::shared_ptr<OHOS::AppExecFwk::EventHandler>> g_uvLoopPumpHandlers;
+
+std::shared_ptr<OHOS::AppExecFwk::EventHandler> GetOrCreateUvLoopPumpHandler()
+{
+    std::shared_ptr<OHOS::AppExecFwk::EventRunner> runner = OHOS::AppExecFwk::EventRunner::Current();
+    if (runner == nullptr) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(g_uvLoopPumpMutex);
+    auto it = g_uvLoopPumpHandlers.find(runner.get());
+    if (it != g_uvLoopPumpHandlers.end()) {
+        return it->second;
+    }
+    auto handler = std::make_shared<OHOS::AppExecFwk::EventHandler>(runner);
+    g_uvLoopPumpHandlers.emplace(runner.get(), handler);
+    HILOG_INFO("LubanCat4 fix: create uv loop pump handler for runner %{public}p", runner.get());
+    return handler;
+}

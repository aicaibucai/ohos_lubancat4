+    // 这里改为由 napi 自己保证：worker 完成后向 JS 线程投递一次 loop 泵。
+    std::shared_ptr<OHOS::AppExecFwk::EventRunner> runner = OHOS::AppExecFwk::EventRunner::Current();
+    if (runner != nullptr) {
+        uvLoopPumpHandler_ = GetOrCreateUvLoopPumpHandler();
+    }
 }
 
